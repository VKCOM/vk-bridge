    "directory": "packages/core"
  },
  "devDependencies": {
    "@rslib/core": "^0.21.2",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.21"
  }
